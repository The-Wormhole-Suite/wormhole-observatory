{
  "schema_version": 17,
  "logging": {
    "enabled": true,
    "level": "INFO",
    "filename": "pihole_manager.log",
    "rotate_bytes": 2000000,
    "backup_count": 3
  },
  "notify": {
    "enable_desktop": false,
    "enable_sound": false,
    "rate_limit_sec": 5,
    "toast_title": "Pi-hole Manager"
  },
  "scans": {
    "enabled": false,
    "interval_sec": 5,
    "batch_size": 200,
    "initial_lookback_sec": 300,
    "queue_trigger_size": 20,
    "max_queue_wait_sec": 300,
    "history_backfill_enabled": false,
    "history_idle_after_sec": 300,
    "history_lookback_days": 30,
    "history_batch_size": 500,
    "excluded_domain_suffixes": [
      ".arpa"
    ]
  },
  "pihole": {
    "base_url": "http://pi.hole",
    "password": "",
    "verify_tls": true,
    "timeout_sec": 10.0
  },
  "external_trigger": {
    "enabled": false,
    "bind_host": "127.0.0.1",
    "port": 8765,
    "token": "",
    "allow_remote": false,
    "max_domains_per_request": 500
  },
  "llm": {
    "enabled": false,
    "interval_sec": 10,
    "worker_batch_size": 25,
    "domains_per_request": 10,
    "min_request_interval_sec": 1.0,
    "max_retries": 2,
    "realtime_quota_reserve_percent": 20.0,
    "quota_wait_timeout_sec": 30.0,
    "unknown_remote_requests_per_minute": 2,
    "unknown_remote_max_domains_per_request": 1,
    "active_provider_index": 0,
    "active_profile_index": 0,
    "automation_mode": "hybrid",
    "simulation_mode": true,
    "default_recheck_days": 30,
    "review_confidence_threshold": 0.75,
    "auto_action_min_confidence": 0.95,
    "require_research_for_auto_action": true,
    "tags": [
      "advertising",
      "cross_site_tracking",
      "analytics",
      "telemetry",
      "crash_reporting",
      "authentication",
      "payments",
      "api_backend",
      "content_media",
      "cdn_shared_infrastructure",
      "software_updates",
      "notifications_messaging",
      "security_antifraud",
      "iot_cloud",
      "malware",
      "phishing",
      "command_and_control",
      "unknown"
    ],
    "tag_policies": {
      "advertising": "deny",
      "cross_site_tracking": "deny",
      "analytics": "manual_review",
      "telemetry": "manual_review",
      "crash_reporting": "manual_review",
      "authentication": "manual_review",
      "payments": "manual_review",
      "api_backend": "manual_review",
      "content_media": "manual_review",
      "cdn_shared_infrastructure": "manual_review",
      "software_updates": "manual_review",
      "notifications_messaging": "manual_review",
      "security_antifraud": "manual_review",
      "iot_cloud": "manual_review",
      "malware": "deny",
      "phishing": "deny",
      "command_and_control": "deny",
      "unknown": "manual_review"
    },
    "tag_recheck_days": {
      "advertising": 30,
      "cross_site_tracking": 30,
      "analytics": 30,
      "telemetry": 30,
      "crash_reporting": 30,
      "authentication": 90,
      "payments": 90,
      "api_backend": 60,
      "content_media": 60,
      "cdn_shared_infrastructure": 90,
      "software_updates": 60,
      "notifications_messaging": 60,
      "security_antifraud": 60,
      "iot_cloud": 45,
      "malware": 7,
      "phishing": 7,
      "command_and_control": 7,
      "unknown": 3
    }
  },
  "research": {
    "max_age_days": 30
  },
  "updates": {
    "check_automatically": false,
    "channel": "stable",
    "check_interval_hours": 24,
    "last_check_at": 0
  },
  "provider_registry": {
    "auto_update": false,
    "refresh_interval_hours": 168,
    "last_checked_at": 0,
    "registry_url": "https://github.com/HyperCriSiS/Pi-Hole-Manager/releases/latest/download/provider-registry.json",
    "signature_url": "https://github.com/HyperCriSiS/Pi-Hole-Manager/releases/latest/download/provider-registry.json.sig"
  },
  "llm_providers": [
    {
      "provider_id": "provider-example",
      "name": "Custom OpenAI-compatible",
      "preset_id": "custom",
      "api_style": "openai_compatible",
      "base_url": "",
      "api_key": "",
      "model": "",
      "temperature": 0.0,
      "timeout_sec": 30.0,
      "max_output_tokens": 4096,
      "max_tokens_parameter": "max_tokens",
      "send_temperature": true,
      "structured_output": "auto",
      "limits": {
        "mode": "auto",
        "quota_group": "",
        "requests_per_minute": 0,
        "requests_per_hour": 0,
        "requests_per_day": 0,
        "input_tokens_per_minute": 0,
        "output_tokens_per_minute": 0,
        "tokens_per_minute": 0,
        "tokens_per_hour": 0,
        "tokens_per_day": 0,
        "units_per_day": 0.0,
        "context_tokens": 0,
        "max_domains_per_request": 0,
        "safety_margin_percent": 10.0
      }
    }
  ],
  "analysis_pools": [
    {
      "pool_id": "realtime",
      "name": "Realtime analysis",
      "enabled": true,
      "mode": "fallback",
      "profile_index": 0,
      "max_parallel_requests": 2,
      "verification_sample_percent": 10,
      "verify_automatic_actions": true,
      "verify_security_risk_at_least": 80,
      "verify_breakage_risk_at_least": 50,
      "memberships": [
        {
          "provider_id": "provider-example",
          "enabled": true,
          "role": "primary",
          "priority": 100,
          "weight": 1
        }
      ]
    },
    {
      "pool_id": "background",
      "name": "Background analysis",
      "enabled": true,
      "mode": "distribute",
      "profile_index": 0,
      "max_parallel_requests": 2,
      "verification_sample_percent": 10,
      "verify_automatic_actions": true,
      "verify_security_risk_at_least": 80,
      "verify_breakage_risk_at_least": 50,
      "memberships": [
        {
          "provider_id": "provider-example",
          "enabled": true,
          "role": "primary",
          "priority": 100,
          "weight": 1
        }
      ]
    }
  ],
  "prompt_profiles": [
    {
      "name": "Balanced",
      "system": "You classify DNS domains for a Pi-hole v6 administrator. Start with the supplied domain dossier and distinguish verified facts from inference. If the selected model and API perform live web search without an additional tool request, independently verify the exact domain using official vendor documentation, GitHub code, issues and discussions, Pi-hole community reports, reputable blocklist repositories such as AdGuardTeam/HostlistsRegistry, hagezi/dns-blocklists, easylist/easylist, disconnectme/disconnect-tracking-protection, and credible user reports. Pi-hole Manager does not currently invoke provider-specific web-search tools. Never claim to have searched the web when browsing is not available. Include useful source URLs in details when known, and prefer manual review when evidence is weak or blocking may break an important service.",
      "user_template": "Analyse the following domain dossiers. Return only the required structured result.\n{domain_dossiers}"
    }
  ],
  "research_providers": [
    {
      "name": "AdGuard service catalog",
      "kind": "adguard_services",
      "enabled": true,
